<odoo>

    <template id="print_cib_cheque_temp">
        <div t-attf-class="header " t-att-style="report_header_style">
            <t t-set="o" t-value="o.with_context(lang=lang)"/>
            <div dir="rtl">

                <div style="float:right;width:50%;text-align:right; font-size:14px; padding-right:100px;padding-top:30px;">
                    <span t-esc="o.cheque_date"/>
                </div>

                <div style="float:right;text-align:right;padding-right:130px;width:100%;padding-top:45px;" name="payee">
                    <span t-field="o.beneficiary_name"/>
                </div>

                <div style="float:right;text-align:right;width:32%;padding-top:58px;font-size:14px;">
                    #<span t-field="o.amount"/>#
                </div>

                <div style="float:left;text-align:right;font-size:11px;width:60%;padding-top:55px;padding-right:80px;">
                    <span class="font-weight-bold">فقط:</span>
                    <span class="font-weight-bold" t-field="o.total_amount_arabic_word"/>
                    <span class="font-weight-bold">لاغير</span>
                </div>


                <div style="float:right;text-align:right;width:100%;padding-top:30px;">
                    <br/>
                    <span style="float:right;text-align:right;padding-right:280px;padding-top:0px;">
                        غير قابل للتظهير
                    </span>
                </div>
            </div>
        </div>
    </template>


    <template id="print_cib_cheque">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="account_cheque.print_cib_cheque_temp" t-lang="lang"/>
            </t>
        </t>
    </template>
</odoo>