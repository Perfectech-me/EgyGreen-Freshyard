<odoo>

    <template id="print_cib_cheque_temp">
        <div t-attf-class="header " t-att-style="report_header_style">
            <t t-set="o" t-value="o.with_context(lang=lang)"/>
            <div dir="rtl">

                <div style="text-align:right;padding-right:5px;padding-top:5px;font-size:12px;">
                    <span t-esc="o.cheque_date.strftime('%Y %m %d')"/>
                </div>



                <div style="float:right;text-align:right;width:32%;padding-top:30px;font-size:11px;">
                    
                </div>


                <div style="float:left;text-align:right;font-size:16px;width:68%;padding-top:20px;">
                    <span t-esc = "o.beneficiary_name"/>


                </div>

                
                <div style = "float:left;text-align:right;font-size:16px;width:68%;padding-top:25px;">
                    <span class="font-weight-bold" t-esc="o.get_amount_in_words(o.amount)"/> 
                </div>
                <div  style = "float:right;text-align:right;width:32%;padding-top:40px;font-size:16px;">
                     #<span t-field="o.amount"/>#
                    <br/>
                    <br/>
                    <br/>
                    
                    <span style="padding-right: 45%; padding-top: 10px;">
                        غير قابل للتظهير
                    </span>
                </div>
                <br/>
                <div style="width: 100%; padding-top: 8px; text-align: right;">

                </div>


            </div>
        </div>
    </template>


    <template id="print_cib_cheque">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="account_cheque.print_cib_cheque_temp" t-lang="lang"/>
            </t>
        </t>
    </template>
</odoo>