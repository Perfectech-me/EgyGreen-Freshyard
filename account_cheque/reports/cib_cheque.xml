<odoo>

    <template id="print_cib_cheque_temp">
        <div t-attf-class="header " t-att-style="report_header_style">
            <t t-set="o" t-value="o.with_context(lang=lang)"/>
            <div dir="rtl">
                <div style="float:right;width:20%;text-align:right; font-size:14px; padding-right:1px; padding-top:40px;">
                    <span t-esc="o.cheque_date"/>
                </div>

                <div style="float:right;text-align:right;padding-right:130px;width:100%;padding-top:70px;" name="payee">
                    <span t-field="o.beneficiary_name"/>
                </div>

                <div style="float:left;text-align:right;font-size:11px;width:68%;padding-top:100px;padding-right:100px;">
                    <span class="font-weight-bold">فقط:</span>
                    <span class="font-weight-bold" t-field="o.total_amount_arabic_word"/>
                    <span class="font-weight-bold">لاغير</span>
                </div>

                <div style="float:right;text-align:right;width:32%;padding-top:105px;padding-right:30px;font-size:14px;">
                    #<span t-field="o.amount"/>#
                </div>

                <div style="width:100%; direction:rtl; text-align:right; padding-top:100px;">
                    <div style="margin-right:100px; font-size:14px;">
                        غير قابل للتظهير
                    </div>
                </div>


            </div>
        </div>
    </template>


    <template id="print_cib_cheque">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="account_cheque.print_cib_cheque_temp" t-lang="lang"/>
            </t>
        </t>
    </template>
</odoo>