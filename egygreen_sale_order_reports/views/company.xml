<odoo>
  <data>
        <record id="res_company_footer_header" model="ir.ui.view">
            <field name="name">Company</field>
            <field name="model">res.company</field>
            <field name="inherit_id" ref="base.view_company_form"/>
            <field name="arch" type="xml">
                <xpath expr="//notebook" position="inside">
                    <page name="layot" string="layout images">
                        <group >
                          <field name="company_qr"  widget="image"/>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>
<!--     \//////          -->

       <record id="view_company_form_inherit_layout_images" model="ir.ui.view">
            <field name="name">res.company.form.report.images</field>
            <field name="model">res.company</field>
            <field name="inherit_id" ref="base.view_company_form"/>
            <field name="arch" type="xml">
                <xpath expr="//notebook" position="inside">
                    <page name="report_images" string="Report Images">
                        <group>
                            <field name="report_logo" widget="image"/>
                            <field name="stamp_image" widget="image"/>
                            <field name="signature_image" widget="image"/>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>
  </data>
</odoo>