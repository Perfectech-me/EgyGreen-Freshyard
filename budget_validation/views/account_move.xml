<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="bills_confirmation_button_view" model="ir.ui.view">
            <field name="name">Confirmation Button</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="(//header/button[@name='action_post'])[2]" position="replace">
                    <button name="action_post" string="Confirm" class="oe_highlight" type="object" groups="account.group_account_invoice,budget_validation.confirmation_bill_button_group" data-hotkey="v" attrs="{'invisible': ['|', '|', '|', ('state', '!=', 'draft'), ('auto_post', '=', True), ('move_type', '=', 'entry'), ('display_inactive_currency_warning','=',True)]}"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>